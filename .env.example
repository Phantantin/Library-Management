# Supply variables to the Spring Boot process. Never commit actual values.
JWT_SECRET=replace-with-at-least-32-random-bytes
# Set true in production so startup fails rather than using an ephemeral key.
JWT_REQUIRE_CONFIGURED_SECRET=false
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Render/Aiven deployment names. Standard SPRING_DATASOURCE_* variables can
# still override these through Spring Boot's environment binding.
DB_URL=jdbc:mysql://localhost:3306/library_db
DB_USERNAME=library
DB_PASSWORD=
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=0
DB_CONNECTION_TIMEOUT=30000
FLYWAY_ENABLED=false
FLYWAY_BASELINE_ON_MIGRATE=false
DDL_AUTO=update
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/library_db
SPRING_DATASOURCE_USERNAME=library
SPRING_DATASOURCE_PASSWORD=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PORT=587
# VNPAY Sandbox. Keep merchant values only in deployment secret variables.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Public HTTPS addresses required for provider callbacks in deployed environments.
BACKEND_PUBLIC_URL=
PAYMENT_CURRENCY=VND
# Optional first-run administrator; password minimum 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
